# Copy to .env and fill in. `docker compose up` refuses to start without the three required values.

# --- Required -----------------------------------------------------------------
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared secret sent by sync clients in the `x-context-token` header.
CONTEXT_WEBHOOK_TOKEN=
# Bearer token protecting the context registry service.
CONTEXT_REGISTRY_TOKEN=

# --- Embeddings (any OpenAI-compatible /embeddings endpoint) -------------------
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# Must match the model's vector size. Changing it requires recreating the collection.
EMBEDDING_DIMENSIONS=1536

# --- Reasoning model ------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional integrations ------------------------------------------------------
# Notion internal integration token; pages must be shared with the integration.
NOTION_API_KEY=
NOTION_BASE_URL=https://api.notion.com
# Slack incoming webhook. Leave empty to skip alerts (the node fails soft).
SLACK_WEBHOOK_URL=

# --- Qdrant ---------------------------------------------------------------------
QDRANT_COLLECTION=internal_context
# Set together with QDRANT__SERVICE__API_KEY on the qdrant service for production.
QDRANT_API_KEY=

# --- Networking -----------------------------------------------------------------
# Public base URL n8n should advertise for webhooks.
N8N_WEBHOOK_BASE_URL=http://localhost:5678/
N8N_HOST_PORT=5678
QDRANT_HOST_PORT=6333
REGISTRY_HOST_PORT=8787

# Copy to .env and fill in. `docker compose up` refuses to start without the required values.
# API keys and tokens only reach the one-shot n8n-import container, which stores them as encrypted
# n8n credentials. The running n8n process never sees them.

# --- Required -----------------------------------------------------------------
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared secret sent by sync clients in the `x-context-token` header.
CONTEXT_WEBHOOK_TOKEN=
# Bearer token protecting the context registry service.
CONTEXT_REGISTRY_TOKEN=
# Qdrant API key (openssl rand -hex 32). Qdrant rejects requests without it.
QDRANT_API_KEY=

# --- Embeddings (any OpenAI-compatible /embeddings endpoint) -------------------
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# Must match the model's vector size. Changing it requires recreating the collection.
EMBEDDING_DIMENSIONS=1536

# --- Reasoning model ------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional integrations ------------------------------------------------------
# Notion internal integration token; pages must be shared with the integration.
NOTION_API_KEY=
NOTION_BASE_URL=https://api.notion.com
# Slack incoming webhook. Leave empty to skip alerts (the node fails soft).
SLACK_WEBHOOK_URL=

# --- Qdrant ---------------------------------------------------------------------
QDRANT_COLLECTION=internal_context

# --- Policy ---------------------------------------------------------------------
# all: record every sync in the registry. compliant_only: skip the registry commit unless the
# verdict is `compliant` (the sync is still indexed, logged and returned to the caller).
REGISTRY_COMMIT_POLICY=all

# --- Networking -----------------------------------------------------------------
# Public base URL n8n should advertise for webhooks (overridden by docker-compose.tls.yml).
N8N_WEBHOOK_BASE_URL=http://localhost:5678/
N8N_HOST_PORT=5678
QDRANT_HOST_PORT=6333
REGISTRY_HOST_PORT=8787

# --- TLS (docker-compose.tls.yml) ----------------------------------------------
# Public hostname; Caddy obtains a certificate for it and exposes only /webhook/*.
N8N_PUBLIC_HOST=
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Queue mode (docker-compose.queue.yml) -------------------------------------
POSTGRES_PASSWORD=
N8N_WORKER_CONCURRENCY=5
